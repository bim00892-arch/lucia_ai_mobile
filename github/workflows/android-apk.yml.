
name: LUCIA AI - Build Android APK

on:
  push:
    branches:
      - main
    paths:
      - ".github/workflows/android-apk.yml"
      - "*.zip"
      - "**/*.zip"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    name: Compile Android APK
    runs-on: ubuntu-latest

    steps:
      - name: Recuperer le depot
        uses: actions/checkout@v4

      - name: Installer Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - name: Installer Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "20"
          cache: npm

      - name: Installer Android SDK
        uses: android-actions/setup-android@v3

      - name: Installer les composants Android
        run: |
          sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0"

      - name: Extraire le projet LUCIA AI
        shell: bash
        run: |
          set -e

          ZIP_FILE="$(find . -maxdepth 2 -type f -iname '*.zip' | head -n 1)"

          if [ -z "$ZIP_FILE" ]; then
            echo "ERREUR : aucun fichier ZIP trouve dans le depot."
            exit 1
          fi

          echo "Archive trouvee : $ZIP_FILE"
          mkdir -p extracted
          unzip -q "$ZIP_FILE" -d extracted

          NATIVE_DIR="$(find extracted -type f -name gradlew -print -quit | xargs -r dirname)"

          if [ -n "$NATIVE_DIR" ] && [ -f "$NATIVE_DIR/app/build.gradle" -o -f "$NATIVE_DIR/app/build.gradle.kts" ]; then
            echo "BUILD_MODE=native" >> "$GITHUB_ENV"
            echo "PROJECT_DIR=$NATIVE_DIR" >> "$GITHUB_ENV"
            echo "Projet Android natif detecte."
          else
            PACKAGE_FILE="$(find extracted -type f -name package.json -not -path '*/node_modules/*' -print -quit)"

            if [ -z "$PACKAGE_FILE" ]; then
              echo "ERREUR : aucun package.json ni projet Android natif detecte."
              exit 1
            fi

            PROJECT_DIR="$(dirname "$PACKAGE_FILE")"
            echo "BUILD_MODE=capacitor" >> "$GITHUB_ENV"
            echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"
            echo "Projet web detecte : $PROJECT_DIR"
          fi

      - name: Preparer le projet Capacitor
        if: env.BUILD_MODE == 'capacitor'
        shell: bash
        run: |
          set -e
          cd "$PROJECT_DIR"

          npm install
          npm run build --if-present

          if [ -f "dist/index.html" ]; then
            WEB_DIR="dist"
          elif [ -f "build/index.html" ]; then
            WEB_DIR="build"
          elif [ -f "www/index.html" ]; then
            WEB_DIR="www"
          elif [ -f "index.html" ]; then
            mkdir -p www
            rsync -a \
              --exclude='www/' \
              --exclude='android/' \
              --exclude='node_modules/' \
              --exclude='.git/' \
              ./ www/
            WEB_DIR="www"
          else
            echo "ERREUR : index.html introuvable apres la preparation web."
            exit 1
          fi

          echo "Dossier web utilise : $WEB_DIR"

          npm install @capacitor/core@^7 @capacitor/android@^7
          npm install --save-dev @capacitor/cli@^7

          cat > capacitor.config.json <<EOF
          {
            "appId": "com.luciaai.mobile",
            "appName": "LUCIA AI",
            "webDir": "$WEB_DIR"
          }
          EOF

          if [ ! -d "android/app" ]; then
            if [ -d "android" ]; then
              rm -rf android
            fi
            npx cap add android
          fi

          npx cap sync android

      - name: Compiler le projet Android natif
        if: env.BUILD_MODE == 'native'
        shell: bash
        run: |
          set -e
          cd "$PROJECT_DIR"
          chmod +x gradlew
          ./gradlew assembleDebug assembleRelease

      - name: Compiler le projet Capacitor
        if: env.BUILD_MODE == 'capacitor'
        shell: bash
        run: |
          set -e
          cd "$PROJECT_DIR/android"
          chmod +x gradlew
          ./gradlew assembleDebug assembleRelease

      - name: Publier les fichiers APK
        uses: actions/upload-artifact@v4
        with:
          name: LUCIA-AI-Android-APK
          path: |
            extracted/**/app/build/outputs/apk/debug/*.apk
            extracted/**/app/build/outputs/apk/release/*.apk
            extracted/**/android/app/build/outputs/apk/debug/*.apk
            extracted/**/android/app/build/outputs/apk/release/*.apk
          if-no-files-found: error
          retention-days: 14
name: Build LUCIA AI Android APK

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - '.github/workflows/android-apk.yml'
      - '*.zip'
      - '**/*.zip'
      - 'package.json'
      - 'capacitor.config.*'

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 45
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Extract project archive
        shell: bash
        run: |
          set -euo pipefail
          ZIP_FILE="$(find . -maxdepth 1 -type f -name 'LUCIA_AI_Android_v0.8_build-cloud*.zip' | sort | head -n 1)"
          if [ -z "$ZIP_FILE" ]; then
            echo '::error::LUCIA AI V0.8 ZIP archive not found at repository root.'
            exit 1
          fi
          mkdir -p extracted
          unzip -q "$ZIP_FILE" -d extracted
          GRADLE_FILE="$(find extracted -type f \( -name build.gradle -o -name build.gradle.kts \) -path '*/app/*' -print -quit)"
          WRAPPER="$(find extracted -type f -name gradlew -print -quit)"
          if [ -n "$GRADLE_FILE" ] && [ -n "$WRAPPER" ]; then
            ROOT="$(dirname "$WRAPPER")"
            echo "PROJECT_ROOT=$ROOT" >> "$GITHUB_ENV"
            echo 'BUILD_MODE=native' >> "$GITHUB_ENV"
          else
            PACKAGE="$(find extracted -type f -name package.json -not -path '*/node_modules/*' -print -quit)"
            if [ -z "$PACKAGE" ]; then
              echo '::error::Archive does not contain a Gradle Android project or package.json.'
              exit 1
            fi
            echo "PROJECT_ROOT=$(dirname "$PACKAGE")" >> "$GITHUB_ENV"
            echo 'BUILD_MODE=capacitor' >> "$GITHUB_ENV"
          fi

      - name: Install dependencies and prepare Capacitor Android
        if: env.BUILD_MODE == 'capacitor'
        working-directory: ${{ env.PROJECT_ROOT }}
        shell: bash
        run: |
          set -euo pipefail
          if [ -f package-lock.json ]; then npm ci; else npm install; fi
          npm run build --if-present
          if [ ! -f capacitor.config.ts ] && [ ! -f capacitor.config.js ] && [ ! -f capacitor.config.json ]; then
            if [ -f dist/index.html ]; then WEB_DIR=dist
            elif [ -f build/index.html ]; then WEB_DIR=build
            elif [ -f www/index.html ]; then WEB_DIR=www
            elif [ -f index.html ]; then WEB_DIR=.
            else echo '::error::No web index.html found after npm build.'; exit 1; fi
            printf '{ "appId": "fr.lucia.ai", "appName": "LUCIA AI", "webDir": "%s" }\n' "$WEB_DIR" > capacitor.config.json
          fi
          npm install @capacitor/core@^7 @capacitor/android@^7
          npm install --save-dev @capacitor/cli@^7
          if [ ! -d android ]; then npx cap add android; fi
          npx cap sync android

      - name: Build APKs
        working-directory: ${{ env.PROJECT_ROOT }}
        shell: bash
        run: |
          set -euo pipefail
          if [ ! -f ./gradlew ]; then echo '::error::Gradle wrapper missing from Android project.'; exit 1; fi
          chmod +x ./gradlew
          ./gradlew --no-daemon assembleDebug assembleRelease

      - name: Upload APK artifacts
        uses: actions/upload-artifact@v4
        with:
          name: LUCIA-Android-APKs
          path: |
            ${{ env.PROJECT_ROOT }}/app/build/outputs/apk/debug/*.apk
            ${{ env.PROJECT_ROOT }}/app/build/outputs/apk/release/*.apk
          if-no-files-found: error
          retention-days: 14
